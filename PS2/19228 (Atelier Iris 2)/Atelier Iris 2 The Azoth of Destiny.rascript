//////////////////// Achievements to Follow ///////////////////ss


function ReachedLevel(levelFunc, threshold)
{
    return 
    InGame() == 0x1 &&
    prev(levelFunc) < threshold &&
    levelFunc >= threshold
}
function ReachedLevel50(levelFunc, threshold)
{
    return 
    InGame() == 0x1 &&
    prev(levelFunc) < threshold &&
    levelFunc == threshold
}

achievement(
    title = "Felt the Bearer",
    description = "Reach Lv 5 with Felt.",
    points = 3,
    trigger = never(MemoryCardAccessor() == 0x144240) &&
    ReachedLevel(CharacterCurrentLevelFelt(), 5)
)

