function FeltAzothForgedCount()
{
    return
        (CharacterWeaponFeltAzureAzoth() / 2) +
        (CharacterWeaponFeltFlamingAzoth() / 2) +
        (CharacterWeaponFeltLightningAzoth() / 2) +
        (CharacterWeaponFeltGaleAzoth() / 2) +
        (CharacterWeaponFeltAlloyAzoth() / 2) +
        (CharacterWeaponFeltDarkAzoth() / 2) +
        (CharacterWeaponFeltHolyAzoth() / 2) +
        (CharacterWeaponFeltDivineAzoth() / 2) +
        (CharacterWeaponFeltSpiritAzoth() / 2) +
        (CharacterWeaponFeltAegisAzoth() / 2) +
        (CharacterWeaponFeltRoyalAzoth() / 2) +
        (CharacterWeaponFeltDestiny() / 2)
}

