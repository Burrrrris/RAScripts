achievement(
    title = "Monster Enthusiast",
    description = "Fill 25% of the Monster List.",
    points = 3,
    trigger =
    never(MemoryCardAccessor() == 0x144240) &&
        InGame() == 0x1 &&
        MonsterListProgress() >= 152 &&
        prev(MonsterListProgress()) < 152
)

achievement(
    title = "Monster Researcher",
    description = "Fill 50% of the Monster List.",
    points = 5,
    trigger =
    never(MemoryCardAccessor() == 0x144240) &&
        InGame() == 0x1 &&
        MonsterListProgress() >= 304 &&
        prev(MonsterListProgress()) < 304
)

achievement(
    title = "Monster Expert",
    description = "Fill 75% of the Monster List.",
    points = 10,
    trigger =
    never(MemoryCardAccessor() == 0x144240) &&
        InGame() == 0x1 &&
        MonsterListProgress() >= 456 &&
        prev(MonsterListProgress()) < 456
)

achievement(
    title = "Monster Encyclopedia Master",
    description = "Completely fill the Monster List.",
    points = 25,
    trigger =
    never(MemoryCardAccessor() == 0x144240) &&
        InGame() == 0x1 &&
        measured(MonsterListProgress() == 607) &&
        prev(MonsterListProgress()) < 607
)


function PeopleListCount()
{
    return
        PeopleListNoin() +
        PeopleListGray() +
        PeopleListFee() +
        PeopleListPoe() +
        PeopleListIris() +
        PeopleListKreuz() +
        PeopleListEizlenHighPriest() +
        PeopleListChaos() +
        PeopleListGalahad() +
        PeopleListTolena() +
        PeopleListTheodore() +
        PeopleListMax() +
        PeopleListYuveria() +
        PeopleListMeila() +
        PeopleListMitsue() +
        PeopleListHagel() +
        PeopleListTheresa() +
        PeopleListYach() +
        PeopleListKlavia() +
        PeopleListLutanus() +
        PeopleListMelona()
}

achievement(
    title = "People Scholar",
    description = "Record 50% of people entries.",
    points = 5,
    trigger =
    never(MemoryCardAccessor() == 0x144240) &&
        InGame() == 0x1 &&
        prev(PeopleListCount()) < 21 &&
        PeopleListCount() >= 21
)

achievement(
    title = "Chronicler of Eden",
    description = "Record 100% of people entries.",
    points = 10,
    trigger =
    never(MemoryCardAccessor() == 0x144240) &&
        InGame() == 0x1 &&
        prev(PeopleListCount()) < 42 &&
        measured(PeopleListCount() >= 42)
)

function ReviewListCount()
{
